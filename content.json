            "title": "CMS Interface"
          },
          {
            "uri": "https://50ic2a1.decoupled.website/modules/custom/dc_import/resources/placeholder.png",
            "alt": "Frontend application example",
            "title": "Frontend App"
          }
        ],
        "tags": [
          "drupal",
          "headless-cms",
          "web-development"
        ],
        "content_blocks": [
          "@block1"
        ]
      }
